# Application Configuration
APP_NAME="Soluciones Edgar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=es

# Database
DB_CONNECTION=pgsql
DATABASE_URL=

# Session & Queue
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# Filesystem & Storage (Cloudflare R2 / AWS S3)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail & Integrations (Brevo)
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=
